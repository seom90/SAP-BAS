<mvc:View controllerName="studentseom.com.sap.training.ux402.fullscreen.ux402fullscreen.controller.Carrier"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m">
    <Page id="carrierpage" title="{i18n>overviewPageTitle}">
        <Table id="carrierTable" items="{/UX_C_Carrier_TP}">
            <columns>
                <Column id='Ccolumn1'>
                    <Text id="Ctext1" text="{i18n>columnId}"/>
                </Column>
                <Column id='Ccolumn2'>
                    <Text id="Ctext2" text="{i18n>columnName}"/>
                </Column>
            </columns>
            <items>            
                <ColumnListItem id="CcolumnListItem1" press="onPress" type="Navigation" >
                    <cells>
                        <ObjectIdentifier id="objectIdentifier1" title="{Carrid}" />
                            <Text id="text3" text="{Carrname}" />                            
                    </cells> 
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>
